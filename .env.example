# Template only: the app does not automatically load .env files.
# Export these values in the shell where you start the app.
# GoodMem connection. The default Docker install uses self-signed HTTPS.
GOODMEM_BASE_URL=https://localhost:8080
GOODMEM_API_KEY=gm_replace_me
GOODMEM_VERIFY_SSL=false

# Option A: reuse resources configured in the bundled GoodMem console.
GOODMEM_EMBEDDER_ID=
GOODMEM_LLM_ID=
GOODMEM_RERANKER_ID=

# Option B: let POST /api/setup create providers (not E2E-validated).
# Default: OpenAI for embedding/chat, with optional Voyage reranking.
OPENAI_API_KEY=
VOYAGE_API_KEY=
